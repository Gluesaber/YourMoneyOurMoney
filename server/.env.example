# Copy this file to ".env" for local development. Never commit the real .env.

# Dev database from docker-compose.yml (host port 5434).
DATABASE_URL="postgresql://ymom:ymom@localhost:5434/ymom?schema=public"

# Signs the session cookie. Any long random string for dev; the server refuses to start without it.
SESSION_SECRET="change-me-to-a-long-random-string"

# Port the API listens on. client/vite.config.ts proxies /api to this port.
PORT=3000

# Runtime mode. The cloud uses "production".
NODE_ENV=development

# First admin password for the seed. Required when NODE_ENV=production.
# ADMIN_PASSWORD=change-me

# Demo users (alice, bob) and their seeded accounts. Default: on locally, off in production.
# SEED_DEMO_DATA=false
# DEMO_USER_PASSWORD=change-me

# Optional directory of built client assets served by Express in single-container production builds.
# CLIENT_DIST_DIR=../client/dist

# Optional database overrides for automated test suites.
# TEST_DATABASE_URL="postgresql://ymom:ymom@localhost:5434/ymom_test?schema=public"
# E2E_DATABASE_URL="postgresql://ymom:ymom@localhost:5434/ymom_e2e?schema=public"
