# Copy this file to ".env" for local development. Never commit the real .env.

# Dev database from docker-compose.yml (host port 5434).
DATABASE_URL="postgresql://ymom:ymom@localhost:5434/ymom?schema=public"

# Signs the session cookie. Any long random string for dev; the server refuses to start without it.
SESSION_SECRET="change-me-to-a-long-random-string"

# Port the API listens on. client/vite.config.ts proxies /api to this port.
PORT=3000

NODE_ENV=development
